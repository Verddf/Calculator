<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Baris tombol -->
    <style name="KeyRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- Tombol dasar -->
    <style name="Key" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">@dimen/key_gap</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/key_text</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/key_num</item>
    </style>

    <style name="Key.Num" />

    <style name="Key.Fn">
        <item name="android:textSize">@dimen/key_text_fn</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:background">@drawable/key_fn</item>
    </style>

    <style name="Key.Op">
        <item name="android:textSize">@dimen/key_text_op</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:background">@drawable/key_op</item>
    </style>

    <style name="Key.Eq">
        <item name="android:textSize">@dimen/key_text_op</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:background">@drawable/key_eq</item>
    </style>

    <!-- Tombol ikon di baris alat -->
    <style name="ToolButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>
</resources>
